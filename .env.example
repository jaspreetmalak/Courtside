# Copy to .env and fill in. NEVER commit .env.
OPENAI_API_KEY=sk-...
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY_SID=SK...
TWILIO_API_SECRET=...
# Optional. If omitted, Courtside reuses or creates its Verify service lazily.
# TWILIO_VERIFY_SERVICE_SID=VA...
# Optional Verify-capable API key. This takes priority over the general key.
# TWILIO_VERIFY_API_KEY_SID=SK...
# TWILIO_VERIFY_API_SECRET=...
# Alternatively, use the Account Auth Token for Verify and Lookup.
# TWILIO_AUTH_TOKEN=...
# Local development only. Never enable this on a public production deployment.
# DEV_BYPASS_PHONE_VERIFICATION=true
# DEV_BYPASS_USAGE_LIMITS=true
# Use a long random value; changing it invalidates stored phone uniqueness hashes.
PHONE_HASH_SECRET=replace-with-at-least-32-random-bytes
# Publicly reachable host for Twilio webhooks (e.g. your ngrok domain, no scheme)
PUBLIC_HOST=example.ngrok.app
# Optional overrides
# DATABASE_URL=sqlite://courtside.db?mode=rwc
# BIND_ADDR=0.0.0.0:3000
# REALTIME_MODEL=gpt-live-1
# CHAT_MODEL=gpt-6-luna
# DECISION_MODEL=gpt-5.6-terra
# SUMMARY_MODEL=gpt-6-luna

# StoreKit 2 / App Store Server Notifications V2
# APP_STORE_PRODUCT_ID=com.malakindustries.courtside.pro.monthly
# APPLE_BUNDLE_ID=com.malakindustries.courtside
# APPLE_ENVIRONMENT=sandbox
# APPLE_APP_ID=1234567890
# APPLE_ROOT_CA_PATH=/absolute/path/to/AppleRootCA-G3.cer

# Keep false for the simulator. Enable for production/device testing after the
# App Attest capability and DeviceCheck key are configured in Apple Developer.
# REQUIRE_APP_ATTEST=true
# APPLE_TEAM_ID=ABCDE12345
# APP_ATTEST_ROOT_CA_PATH=/absolute/path/to/Apple_App_Attestation_Root_CA.pem
# DEVICECHECK_KEY_ID=ABC123DEFG
# DEVICECHECK_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_ABC123DEFG.p8

# Exact browser origins allowed to use the bearer-authenticated API.
WEB_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
